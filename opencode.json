{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "**": "allow",
      "docs/secret/**": "deny"
    },
    "write": {
      "**": "allow",
      "docs/secret/**": "deny"
    },
    "edit": {
      "**": "allow",
      "docs/secret/**": "deny"
    }
  },
  "agent": {
    "script-agent": {
      "permission": {
        "skill": {
          "bash-generator": "allow",
          "python-generator": "allow",
          "ps-generator": "allow",
          "zsh-generator": "allow"
        }
      }
    },
    "web-app-developer": {
      "permission": {
        "skill": {
          "nextjs-logic": "allow"
        }
      }
    },
    "speckit-agent": {
      "permission": {
        "read": "allow",
        "edit": {
          "*": "deny",
          ".specify/**": "allow",
          ".opencode/**": "allow",
          "apps/**": "allow",
          "apps/dashboard/**": "deny"
        },
        "grep": "allow",
        "glob": "allow",
        "bash": "allow"
      }
    }
  }
}
